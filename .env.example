# Alles optional. Ohne .env läuft grundpass-core mit PGlite im Ordner ./data.

# Postgres für Prod (Neon etc.). Leer = PGlite lokal.
DATABASE_URL=

# Ordner für PGlite (Dev). Leer = ./data/grundpass
PGLITE_DIR=

# ntfy.sh-Topic für Alarme. Leer = nur Log.
NTFY_TOPIC=

# Token für POST /internal/canary. Leer = Endpoint deaktiviert.
CANARY_TOKEN=

# Adapter abschalten, kommagetrennt. Beispiel: laerm-strasse,radon
GP_DISABLED_ADAPTERS=

# HTTP
PORT=3000
GP_USER_AGENT=grundpass-core/0.1 (+https://grundpass.ch)
